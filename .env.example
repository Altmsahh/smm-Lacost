# ── Database (PostgreSQL - Neon) ──
DATABASE_URL="postgresql://username:password@ep-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://username:password@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── JWT Secret ──
JWT_SECRET="your-secure-jwt-secret-key"

# ── API Base URL (Optional - defaults to /api) ──
NEXT_PUBLIC_API_BASE_URL="/api"
